# config.env.example
#
# 복사해서 쓰십시오.  copy config.env.example config.env
# config.env 는 .gitignore 대상입니다. 기계마다 경로가 다르니 커밋하지 않습니다.
#
# 형식: KEY=VALUE  (따옴표 없이, 줄 끝 주석 없이)
# 경로에 공백이 있어도 따옴표를 붙이지 마십시오. 줄 전체를 값으로 읽습니다.
#   예: DATA_ROOT=D:/battery_data/Life labels     ← 이대로 씁니다

# --------------------------------------------------------------------------
# 데이터 경로
# --------------------------------------------------------------------------
# DATA_ROOT     데이터 최상위. 아래 경로들의 기준점.
# ZENODO_DIR    내려받은 zip 을 모아두는 곳
# EXTRACT_DIR   zip 을 푼 곳. 서브셋 폴더(CALB/, SNL/, ...)와
#               "Life labels/" 가 이 아래에 놓입니다.
# HF_DIR        HuggingFace 에서 받은 것. processed_SOH/ 가 이 아래입니다.
# CKPT_ROOT     학습 체크포인트 저장 위치. 디스크 여유가 있는 곳으로.

DATA_ROOT=D:/battery_data
ZENODO_DIR=D:/battery_data/zenodo
EXTRACT_DIR=D:/battery_data/dataset
HF_DIR=D:/battery_data/hf
CKPT_ROOT=D:/battery_data/checkpoints

# --------------------------------------------------------------------------
# 실행 자원 — 117호 기준 기본값
# --------------------------------------------------------------------------
# 상위 저장소 기본값은 GPU 2~4장 · 워커 32 · batch 32 입니다.
# 그대로 쓰면 단일 GPU 기계에서 실패합니다. 아래가 안전한 출발점입니다.
#
# NUM_PROCESSES=1 이면 train/paths.py 가 accelerate 의 --multi_gpu 를
# 제거합니다. 이것을 남겨두는 것이 단일 GPU 에서 실패하는 원인입니다.

CUDA_DEVICES=0
NUM_PROCESSES=1
NUM_WORKERS=4
BATCH_SIZE=8

# --------------------------------------------------------------------------
# HuggingFace — 게이트 저장소
# --------------------------------------------------------------------------
# 로그인 · 조건 동의 후 토큰을 발급받아야 합니다.
# BatteryMFormer 재현에는 revision v11 이 필요합니다 (Zenodo zip 에는
# processed_SOH/ 가 없어 대체되지 않습니다).
# 이 하니스는 HuggingFace 에 접근하지 않습니다. 사람이 직접 받으십시오.

HF_TOKEN=
HF_REVISION=v11
